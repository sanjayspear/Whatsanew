-- Offline-first local store. Listings are cached as JSON documents (schema evolves with the
-- API without migrations); signals and prefs are relational.

CREATE TABLE listing_cache (
    id TEXT NOT NULL PRIMARY KEY,
    region_code TEXT NOT NULL,
    category TEXT NOT NULL,
    lat REAL NOT NULL,
    lng REAL NOT NULL,
    json TEXT NOT NULL,
    fetched_at INTEGER NOT NULL,
    -- Lower-case names + tagline, so searches filter by name/category before loading JSON (migration 2).
    search_text TEXT NOT NULL DEFAULT ''
);

CREATE INDEX listing_cache_region ON listing_cache(region_code, category);
CREATE INDEX listing_cache_lat_lng ON listing_cache(lat, lng);

CREATE TABLE signal (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    json TEXT NOT NULL,
    at_epoch_ms INTEGER NOT NULL,
    uploaded INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX signal_time ON signal(at_epoch_ms);

-- The personal shelf: places the user saved. Full JSON so it works offline and survives cache eviction.
CREATE TABLE saved_listing (
    listing_id TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL,
    saved_at INTEGER NOT NULL
);

CREATE TABLE kv (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

upsertListing:
INSERT OR REPLACE INTO listing_cache(id, region_code, category, lat, lng, json, fetched_at, search_text)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

candidatesInBox:
SELECT id, category, lat, lng, search_text FROM listing_cache WHERE lat BETWEEN ? AND ? AND lng BETWEEN ? AND ?;

listingsByIds:
SELECT json FROM listing_cache WHERE id IN ?;

untitledListings:
SELECT id, json FROM listing_cache WHERE search_text = '' LIMIT ?;

setSearchText:
UPDATE listing_cache SET search_text = ? WHERE id = ?;

listingsInRegion:
SELECT json FROM listing_cache WHERE region_code = ?;

recentListings:
SELECT json FROM listing_cache ORDER BY fetched_at DESC LIMIT ?;

listingsInBox:
SELECT json FROM listing_cache WHERE lat BETWEEN ? AND ? AND lng BETWEEN ? AND ? LIMIT ?;

countInRegion:
SELECT COUNT(*) FROM listing_cache WHERE region_code = ?;

evictListingsOlderThan:
DELETE FROM listing_cache WHERE fetched_at < ?;

insertSignal:
INSERT INTO signal(json, at_epoch_ms) VALUES (?, ?);

signalsSince:
SELECT json FROM signal WHERE at_epoch_ms >= ? ORDER BY at_epoch_ms;

pendingSignals:
SELECT id, json FROM signal WHERE uploaded = 0 ORDER BY id LIMIT ?;

markUploaded:
UPDATE signal SET uploaded = 1 WHERE id IN ?;

pruneUploaded:
DELETE FROM signal WHERE uploaded = 1 AND at_epoch_ms < ?;

getValue:
SELECT value FROM kv WHERE key = ?;

putValue:
INSERT OR REPLACE INTO kv(key, value) VALUES (?, ?);

saveListing:
INSERT OR REPLACE INTO saved_listing(listing_id, json, saved_at) VALUES (?, ?, ?);

unsaveListing:
DELETE FROM saved_listing WHERE listing_id = ?;

savedListings:
SELECT json FROM saved_listing ORDER BY saved_at DESC;

savedIds:
SELECT listing_id FROM saved_listing;

deleteValue:
DELETE FROM kv WHERE key = ?;

deleteValuesWithPrefix:
DELETE FROM kv WHERE key >= ? AND key < ?;

clearSavedListings:
DELETE FROM saved_listing;

deleteListing:
DELETE FROM listing_cache WHERE id = ?;
